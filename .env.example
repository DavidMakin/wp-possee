# Domain
DOMAIN=yourdomain.com

# WordPress database — must exist in your MariaDB instance
# CREATE DATABASE wordpress; CREATE USER 'wordpress'@'%' IDENTIFIED BY '...'; GRANT ALL ON wordpress.* TO 'wordpress'@'%';
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=change_me_wp

# Cloudflare Tunnel token (Zero Trust dashboard → Tunnels → your tunnel → Configure)
# Keep secret — do not commit
CLOUDFLARE_TUNNEL_TOKEN=

# WordPress admin account (used by install-plugins.sh on first run)
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change_me_admin
WP_ADMIN_EMAIL=you@yourdomain.com
