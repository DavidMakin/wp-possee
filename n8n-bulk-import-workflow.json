{
  "name": "Hardcover → WordPress (bulk historical import)",
  "nodes": [
    {
      "parameters": {},
      "id": "b1000001-0001-0001-0001-000000000001",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { offset: 0, allBooks: [] } }];"
      },
      "id": "b1000001-0002-0002-0002-000000000002",
      "name": "Init",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.hardcover.app/v1/graphql",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\n  \"query\": \"query { me { user_books(where: { status_id: { _eq: 3 } }, order_by: { updated_at: asc }, limit: 1000) { id updated_at rating book { title contributions { author { name } } editions(limit: 1, order_by: { users_count: desc }) { isbn_13 isbn_10 } } } } }\"\n}"
      },
      "id": "b1000001-0003-0003-0003-000000000003",
      "name": "Fetch all finished books",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "hardcover-api-key",
          "name": "Hardcover API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst userBooks = data?.data?.me?.[0]?.user_books ?? [];\n\nreturn userBooks.map(ub => {\n  const book = ub.book;\n  const title = book?.title ?? 'Unknown Title';\n  const authors = (book?.contributions ?? []).map(c => c.author?.name).filter(Boolean);\n  const author = authors.join(', ') || null;\n  const editions = book?.editions ?? [];\n  const isbn13 = editions[0]?.isbn_13 ?? null;\n  const isbn10 = editions[0]?.isbn_10 ?? null;\n  const isbn = isbn13 || isbn10 || null;\n  const rating = ub.rating ?? null;\n\n  let summary = `Finished reading: ${title}`;\n  if (author) summary += ` by ${author}`;\n  if (rating !== null) {\n    const stars = Math.round(rating);\n    const starStr = '\\u2605'.repeat(stars) + '\\u2606'.repeat(5 - stars);\n    summary += ` ${starStr} (${rating}/5)`;\n  }\n\n  const readOfProps = { name: [title] };\n  if (author) readOfProps.author = [author];\n  if (isbn) readOfProps.uid = [`isbn:${isbn}`];\n\n  const micropubBody = {\n    type: ['h-entry'],\n    properties: {\n      summary: [summary],\n      'read-status': ['finished'],\n      'read-of': [\n        {\n          type: ['h-cite'],\n          properties: readOfProps\n        }\n      ],\n      visibility: ['public'],\n      'post-status': ['published']\n    }\n  };\n\n  return { json: { micropubBody, title } };\n});"
      },
      "id": "b1000001-0004-0004-0004-000000000004",
      "name": "Build Micropub payloads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "batchSize": 10,
        "options": {}
      },
      "id": "b1000001-0005-0005-0005-000000000005",
      "name": "Split into batches of 10",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://blog.sleep-er.co.uk/wp-json/micropub/1.0/endpoint",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json.micropubBody) }}"
      },
      "id": "b1000001-0006-0006-0006-000000000006",
      "name": "POST to Micropub",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "micropub-token",
          "name": "Micropub Bearer Token"
        }
      }
    },
    {
      "parameters": {
        "unit": "seconds",
        "resume": "timeInterval",
        "amount": 30
      },
      "id": "b1000001-0007-0007-0007-000000000007",
      "name": "Wait 30s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1560, 300],
      "webhookId": "bulk-import-wait"
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [{ "node": "Init", "type": "main", "index": 0 }]
      ]
    },
    "Init": {
      "main": [
        [{ "node": "Fetch all finished books", "type": "main", "index": 0 }]
      ]
    },
    "Fetch all finished books": {
      "main": [
        [{ "node": "Build Micropub payloads", "type": "main", "index": 0 }]
      ]
    },
    "Build Micropub payloads": {
      "main": [
        [{ "node": "Split into batches of 10", "type": "main", "index": 0 }]
      ]
    },
    "Split into batches of 10": {
      "main": [
        [{ "node": "POST to Micropub", "type": "main", "index": 0 }],
        []
      ]
    },
    "POST to Micropub": {
      "main": [
        [{ "node": "Wait 30s", "type": "main", "index": 0 }]
      ]
    },
    "Wait 30s": {
      "main": [
        [{ "node": "Split into batches of 10", "type": "main", "index": 0 }]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  },
  "staticData": null,
  "tags": [],
  "triggerCount": 0
}
